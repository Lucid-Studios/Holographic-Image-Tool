{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oan.hopng_phase_policy.v0.1.0.json",
  "title": "HOPNG Phase Policy",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "artifactId",
    "rawCadenceMs",
    "eventGroupingMode",
    "eventGroupingSizeRawSlices",
    "phaseWindowMode",
    "phaseWindowSizeEventSlices",
    "phaseWindowDurationMs",
    "maxPhaseWindowSpanMs",
    "comparisonHorizonRawSlices",
    "comparisonHorizons",
    "aggregationPolicies",
    "stateThresholds",
    "primeSafeInspectionMode",
    "privilegedInspectionMode"
  ],
  "properties": {
    "schema": { "const": "oan.hopng_phase_policy" },
    "schemaVersion": { "const": "0.1.0" },
    "artifactId": { "type": "string" },
    "phaseWindowDurationMs": { "type": "integer", "minimum": 1 },
    "maxPhaseWindowSpanMs": { "type": "integer", "minimum": 1 },
    "comparisonHorizons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "horizonId",
          "mode",
          "value",
          "useForStateClassification"
        ],
        "properties": {
          "horizonId": { "type": "string" },
          "mode": { "type": "string", "enum": ["raw_slices", "duration_ms"] },
          "value": { "type": "integer", "minimum": 1 },
          "useForStateClassification": { "type": "boolean" }
        }
      }
    },
    "stateThresholds": {
      "type": "object",
      "required": [
        "risingPressureMin",
        "driftingAbsoluteMin",
        "propagatingBloomMin",
        "rupturePressureMin",
        "ruptureDriftAbsoluteMin",
        "directionDriftAbsoluteMin",
        "forcePressureWeight",
        "forceDriftWeight",
        "forceBloomWeight",
        "forceTopologyBonus"
      ]
    }
  }
}
